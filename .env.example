# Copy to .env in this same directory - docker-compose reads it automatically.
# Every value here has a working default baked into docker-compose.yml;
# you only need this file to override something.

# --- Database ---------------------------------------------------------
POSTGRES_USER=sih_admin
POSTGRES_PASSWORD=changeme_in_env
POSTGRES_DB=doc_forgery_db

# --- Backend general ----------------------------------------------------
ENV=development
MAX_UPLOAD_MB=10

# --- Risk Fusion Engine weights (must sum to 1.0) ------------------------
WEIGHT_OCR_CONFIDENCE=0.25
WEIGHT_ELA_TAMPER=0.40
WEIGHT_FACE_MATCH=0.35

# --- Verdict thresholds on the fused 0-100 trust score -------------------
THRESHOLD_GENUINE=75
THRESHOLD_SUSPICIOUS=45

# --- ELA (Error Level Analysis) tunables ---------------------------------
# See backend/app/services/ela_detector.py module docstring for what each
# one controls before changing these - they were tuned against synthetic
# test images, not a large real-world sample set yet.
ELA_JPEG_QUALITY=90
ELA_SCORE_LOW_BOUND=4.0
ELA_SCORE_HIGH_BOUND=55.0
ELA_COMPRESSION_WARNING_QUANT_MEAN_THRESHOLD=15.0
